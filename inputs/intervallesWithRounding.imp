class IntervallesWithRoundingTest {
    basic() {
        def i = 4;
        def j = 2.4;
        def a = i + j;
        def s = i - j;
        def m = i * j;
        def d = i / j;
    }

    conditional() {
        def x = 10.0;
        def y = 3.0;
        def z = 2.0;
        
        while (z < 5.0) {
            z = z + 1.0;
        }

        if (x > 5.0) {
            y = y * 2.0;
        } else {
            y = y / 2.0;
        }

        for (def i = 0; i < 10; i = i + 1) {
            z = z + 1.0;
        }
    }

}
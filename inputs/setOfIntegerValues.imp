class setOfIntegerValues {
	basic() {
		def i = 2;
		def j = -10;
		def a = i + j;
		def s = i - j;
		def m = i * j;
		def d = i / j;
	}

	severalValues() {
	    def i = 2;
        def j = -10;
        def a = i + j;
        def s = i - j;
        def m = i * j;
        def d = i / j;

        if(i > 1) {
            i = 1;
            j = 2;
        }
        if(i < 1) {
            i = 1;
            j = 2;
        }

        whileStatement () {
            def i = 0;
            while(i < 124) {
                i = i + 1;
            }
        }
	}
}